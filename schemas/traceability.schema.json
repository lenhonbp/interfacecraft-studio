{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lenhonbp/interfacecraft-studio/schemas/traceability.schema.json",
  "title": "InterfaceCraft Traceability Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["nodes", "edges"],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "artifact"],
        "properties": {
          "id": { "type": "string", "pattern": "^(BRF|JNY|SCR|ST|CMP|ACC|EVD)-[0-9]{3,}$" },
          "type": { "enum": ["BRF", "JNY", "SCR", "ST", "CMP", "ACC", "EVD"] },
          "artifact": { "type": "string", "minLength": 1 }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "relation", "artifact"],
        "properties": {
          "from": { "type": "string", "pattern": "^(BRF|JNY|SCR|ST|CMP|ACC|EVD)-[0-9]{3,}$" },
          "to": { "type": "string", "pattern": "^(BRF|JNY|SCR|ST|CMP|ACC|EVD)-[0-9]{3,}$" },
          "relation": { "enum": ["proven-by", "captured-by", "contains-state", "owns-state", "navigates-to"] },
          "artifact": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
