{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lenhonbp/interfacecraft-studio/schemas/traceability.schema.json",
  "title": "InterfaceCraft Traceability Graph",
  "type": "object",
  "required": ["nodes", "edges"],
  "properties": {
    "nodes": { "type": "array", "items": { "type": "object", "required": ["id", "type", "artifact"], "properties": { "id": { "type": "string", "pattern": "^(BRF|JNY|SCR|ST|CMP|ACC|EVD)-[0-9]{3,}$" }, "type": { "enum": ["brief", "journey", "screen", "state", "component", "acceptance", "evidence"] }, "artifact": { "type": "string" } } } },
    "edges": { "type": "array", "items": { "type": "object", "required": ["from", "to", "relation"], "properties": { "from": { "type": "string" }, "to": { "type": "string" }, "relation": { "type": "string" } } } }
  }
}
