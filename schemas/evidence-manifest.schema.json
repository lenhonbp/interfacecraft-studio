{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lenhonbp/interfacecraft-studio/schemas/evidence-manifest.schema.json",
  "title": "InterfaceCraft Evidence Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "project", "context", "items"],
  "properties": {
    "contractVersion": { "type": "string", "enum": ["0.2", "0.3"] },
    "project": { "type": "string" },
    "context": { "type": "string", "enum": ["web-experience", "web-app", "game-experience", "playable-web-game"] },
    "items": { "type": "array", "items": { "$ref": "#/$defs/evidenceItem" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^((BRF|JNY|SCR|ST|CMP|ACC|EVD)-[0-9]{3,})$" },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "path", "states", "criteria", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^EVD-[0-9]{3,}$" },
        "type": { "enum": ["screenshot", "visual-strip", "manual-traversal", "recording", "automated-check", "runnable-demo", "other"] },
        "path": { "type": "string", "minLength": 1, "pattern": "^(?![\\/])(?![A-Za-z]:)(?!.*(^|[\\/])\\.\\.([\\/]|$)).+" },
        "viewport": { "type": "string" },
        "screen": { "type": "string", "pattern": "^SCR-[0-9]{3,}$" },
        "components": { "type": "array", "items": { "type": "string", "pattern": "^CMP-[0-9]{3,}$" } },
        "states": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^ST-[0-9]{3,}$" } },
        "criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^ACC-[0-9]{3,}$" } },
        "input": { "type": "string" },
        "status": { "enum": ["pending", "ready", "failed", "skipped", "not-applicable"] },
        "notes": { "type": "string" }
      }
    }
  }
}
